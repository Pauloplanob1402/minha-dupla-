# Copie este arquivo pra .env.local e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave da API do Daily.co (áudio da sala). NUNCA leva o prefixo NEXT_PUBLIC_
# porque essa chave precisa ficar só no servidor, nunca no navegador.
DAILY_API_KEY=sua-chave-do-daily-aqui
